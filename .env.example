# Anthropic API key — used only by the Node server, never sent to the browser.
ANTHROPIC_API_KEY=
# Model used for image analysis and free-text edit requests.
CLAUDE_MODEL=claude-sonnet-5
# Port of the API server (Vite dev server proxies /api to it).
PORT=8787
# Optional: require this password for the AI endpoints (recommended for a public deployment).
APP_PASSWORD=
