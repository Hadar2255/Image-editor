{
  "name": "raw-photo-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node e2e/smoke.mjs",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
